# Base URL of the backend as seen from the *browser*.
# Leave empty when the API is proxied under the same origin (the normal setup):
# every request path already starts with /api/v1, so no prefix is needed.
# Set it to an absolute URL (e.g. http://localhost:8080) only for a cross-origin
# backend — that also requires CORS_ALLOWED_ORIGINS on the backend side.
VITE_API_URL=
